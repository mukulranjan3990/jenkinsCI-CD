pipeline {
    agent any

    environment {
        // Define your environment variables here
        APPLICATION_NAME = 'my-app'
        DEPLOY_ENV       = 'staging'
    }

    stages {
        // 1. CHECKOUT STAGE
        stage('Checkout') {
            steps {
                echo 'Pulling the latest code from Git...'
                checkout scm
            }
        }

        // 2. BUILD STAGE
        stage('Build') {
            steps {
                echo 'Building the application...'
                // Example for Node.js: sh 'npm install && npm run build'
                // Example for Java/Maven: sh './mvnw clean package -DskipTests'
                sh 'echo "Compilation and bundling complete."'
            }
        }

        // 3. TEST STAGE
        stage('Test') {
            steps {
                echo 'Running Unit and Integration Tests...'
                // Example: sh 'npm test' or sh './mvnw test'
                sh 'echo "All tests passed successfully."'
            }
        }

        // 4. CODE ANALYSIS STAGE
        stage('Code Quality & Security') {
            steps {
                echo 'Scanning code for bugs, vulnerabilities, and formatting...'
                // Example for SonarQube:
                // waitForQualityGate abortPipeline: true
                sh 'echo "Static code analysis completed. Quality gate passed."'
            }
        }

        // 5. DEPLOY STAGE
        stage('Deploy') {
            steps {
                echo "Deploying application to the ${env.DEPLOY_ENV} environment..."
                // Example: sh 'kubectl apply -f k8s/' or ssh deployment scripts
                sh 'echo "Deployment successful!"'
            }
        }
    }

    // Post-execution blocks for notifications and cleanup
    post {
        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully! Sending success notification...'
        }
        failure {
            echo 'Pipeline failed! Sending alert to the team...'
        }
    }
}
